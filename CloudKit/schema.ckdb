// ShittyFriends CloudKit schema (container iCloud.com.sakara.shittyfriends).
// Import into Development with cktool (see CloudKit/README.md), then use
// CloudKit Console > Deploy Schema Changes to push it to Production.
DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    // Private/shared databases. Whole model is JSON in `json`; adding model fields never needs a schema change.
    RECORD TYPE Profile (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        json            BYTES,
        schemaVersion   INT64,
        updatedAt       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

