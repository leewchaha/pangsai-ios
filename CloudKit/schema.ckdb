    // Friend invite card (root of a public read-only record share). Holds only the invite payload.
    RECORD TYPE InviteCard (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        payload         STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    // Public database: anonymous pings. `to` is a random inbox token; `ref` is AES-GCM sealed.
    // Readable only by signed-in iCloud users (every ShittyFriends user is), not the open web.
    // Query subscriptions filter on `to` and `kind`, so both must be QUERYABLE.
    RECORD TYPE Ping (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        exp             TIMESTAMP QUERYABLE SORTABLE,
        "from"          STRING,
        kind            STRING QUERYABLE,
        ref             STRING,
        "to"            STRING QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );
